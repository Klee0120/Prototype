{
  "manifest_version": 3,
  "name": "ServiceWorks Time Tracker",
  "short_name": "ServiceWorks",
  "version": "1.0.0",
  "description": "Log admin time against ServiceWorks categories, POs, and technicians without leaving your current tab.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ServiceWorks Time Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://services-works.com/*"],
  "minimum_chrome_version": "102"
}
